[Unit]
Description=Check GitHub and safely update the hosted Pivot app
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/pivot-trader
ExecStart=/usr/bin/python3 %h/pivot-trader/config/update_from_github.py --root %h/pivot-trader
TimeoutStartSec=25min
UMask=0077
NoNewPrivileges=true
