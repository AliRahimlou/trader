# Both test stages are dependencies of the final image. Build without credentials.
FROM node:22-bookworm-slim AS web
WORKDIR /app
COPY dashboard/package.json dashboard/package-lock.json ./dashboard/
RUN npm ci --prefix dashboard --ignore-scripts
COPY dashboard/vite.config.js ./dashboard/
COPY pivot/web ./pivot/web/
RUN node --test pivot/web/model.test.mjs && npm --prefix dashboard run build -- --base=./

FROM python:3.12-slim-bookworm AS tested
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PATH="/opt/venv/bin:$PATH"
WORKDIR /app
COPY deploy/requirements.lock /tmp/requirements.lock
RUN python -m venv /opt/venv && pip install --no-cache-dir -r /tmp/requirements.lock
COPY pivot ./pivot/
COPY deploy ./deploy/
COPY backend_server.py ./
RUN python -m pytest pivot/tests deploy/tests -q

FROM python:3.12-slim-bookworm AS runtime
ARG PIVOT_REVISION
LABEL org.opencontainers.image.source="https://github.com/AliRahimlou/trader" \
      org.opencontainers.image.revision="${PIVOT_REVISION}"
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PATH="/opt/venv/bin:$PATH" \
    PIVOT_REVISION="${PIVOT_REVISION}"
WORKDIR /app
RUN groupadd --gid 1000 pivot && useradd --uid 1000 --gid 1000 --no-create-home pivot \
    && mkdir -p /app/runtime /app/pivot && chown 1000:1000 /app/runtime
COPY --from=tested /opt/venv /opt/venv
COPY pivot/*.py ./pivot/
COPY backend_server.py ./
COPY --from=web /app/dashboard/dist ./pivot/web/
USER 1000:1000
EXPOSE 8011
HEALTHCHECK --interval=15s --timeout=5s --start-period=45s --retries=4 \
    CMD python -c "import json,urllib.request; r=json.load(urllib.request.urlopen('http://127.0.0.1:8011/api/health',timeout=4)); assert r.get('ok') is True and r.get('legacy_loaded') is False"
CMD ["python", "backend_server.py", "--host", "0.0.0.0", "--port", "8011"]
