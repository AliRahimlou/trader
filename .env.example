# Existing provider credentials. Orders additionally require saved owner permission.
# No legacy LIVE_* flag is consumed.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_API_BASE_URL=https://api.alpaca.markets
APCA_API_FEED=iex
# Free actual Cboe VIX REST data; cached candles and on-demand entry quotes.
VIX_PROVIDER=insightsentry
INSIGHTSENTRY_API_KEY=
# Optional older adapter. Select VIX_PROVIDER=massive explicitly to use it.
MASSIVE_API_KEY=
# Optional hosted configuration. Keep empty for local development.
# The public route must be protected by an authenticated reverse proxy.
PUBLIC_ORIGIN=
URL_PREFIX=
PIVOT_RUNTIME_NAME=
PIVOT_REVISION=
